# ---------------------------------------------------------------------------
# Supabase (client-safe)
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ---------------------------------------------------------------------------
# Server-only secrets. Never use a VITE_ prefix for these values.
# ---------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API -> secret key.
# Without this, privileged server functions run as `anon` and are rejected by RLS.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
# For projects using the newer key format, this alias also works:
# SUPABASE_SECRET_KEY="sb_secret_..."

# HMAC key for the `buzzhub_sid` session cookie. Minimum 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# ---------------------------------------------------------------------------
# Optional: only needed to apply hardening migrations with `npm run db:apply`.
# Use ONE of these paths.
# ---------------------------------------------------------------------------
# Path 1 - direct connection string (psql must be installed):
# DATABASE_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
# Path 2 - database password only (script builds the connection string):
# SUPABASE_DB_PASSWORD="<db-password>"
# Path 3 - Supabase Management API token (no psql needed):
# SUPABASE_ACCESS_TOKEN="sbp_..."
